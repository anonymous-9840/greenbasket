# Green Basket Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Automatically connects if MongoDB is running, with local persistent store fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/greenbasket

# JWT Secret for Customer & Admin Authentication
JWT_SECRET=green_basket_super_secret_jwt_key_change_in_production_2026

# Razorpay Payment Gateway Credentials (India)
# Replace with live/test keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_greenbasket_demo_key
RAZORPAY_KEY_SECRET=rzp_test_greenbasket_demo_secret

# Optional Notification Providers (Email / SMS OTP & Delivery Reminders)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@greenbasket.in
SMTP_PASS=your_smtp_password
SMS_PROVIDER_API_KEY=your_sms_gateway_key
